{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/masterplan/pano.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/admin/loginform.html",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/admin/adminform.html",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/admin/adminform.hrml",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/loginForm.html",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/loginform.html",
      "destination": "/admin/loginForm.html"
    },
    {
      "source": "/adminForm.html",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/adminform.html",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/adminform.hrml",
      "destination": "/admin/adminForm.html"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/website/index.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/website/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/website/js/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "/website/img/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/website/assets/$1"
    },
    {
      "source": "/modal/(.*)",
      "destination": "/website/modal/$1"
    },
    {
      "source": "/styles.css",
      "destination": "/website/styles.css"
    },
    {
      "source": "/whatsappbutton.css",
      "destination": "/website/whatsappbutton.css"
    },
    {
      "source": "/FavIcon.png",
      "destination": "/website/FavIcon.png"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/**"
    }
  },
  "headers": [
    {
      "source": "/masterplan/pano.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ]
}
